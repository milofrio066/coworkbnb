# Obligatorios (cámbialos)
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
ADMIN_PASSWORD=cambia-esta-clave-del-admin

# Base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg://cowork:cowork@localhost:5432/cowork

# Opcionales
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
HTTPS_ONLY=false

# Demo: muestra las cuentas de prueba en el login (quítalo en producción)
DEMO_MODE=false
